# NEXT_PUBLIC_SITE_URL: URL pública canônica do site (sem barra no final).
# Alimenta metadataBase, canonical, Open Graph, robots.txt e sitemap.xml.
# Se não for definida, o padrão é https://tgdistribuidora.com.br
NEXT_PUBLIC_SITE_URL="https://tgdistribuidora.com.br"

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: código de verificação do
# Google Search Console (método "tag HTML" — apenas o valor do content).
# Opcional: se ficar vazio, nenhuma meta tag de verificação é emitida.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Loja (/produtos): o catálogo vem da vitrine do Syncro.
# NEXT_PUBLIC_SYNCRO_URL: endereço do Syncro (sem barra no final).
# NEXT_PUBLIC_SYNCRO_CHAVE: chave do site, gerada no Syncro em
#   Vitrine › Configurações › Sites (cadastre https://www.tgdistribuidora.com.br).
#   É pública por desenho — o Syncro só a aceita vinda do domínio cadastrado.
# Sem as duas, /produtos mostra "catálogo indisponível" e o resto do site segue normal.
NEXT_PUBLIC_SYNCRO_URL=""
NEXT_PUBLIC_SYNCRO_CHAVE=""
