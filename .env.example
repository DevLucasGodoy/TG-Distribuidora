# NEXT_PUBLIC_SITE_URL: URL pública canônica do site (sem barra no final).
# Alimenta metadataBase, canonical, Open Graph, robots.txt e sitemap.xml.
# Se não for definida, o padrão é https://tgdistribuidora.com.br
NEXT_PUBLIC_SITE_URL="https://tgdistribuidora.com.br"

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: código de verificação do
# Google Search Console (método "tag HTML" — apenas o valor do content).
# Opcional: se ficar vazio, nenhuma meta tag de verificação é emitida.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
